{
	"name": "@nestm/permissions-typeorm",
	"version": "0.1.0-alpha.3",
	"description": "TypeORM policy store and query-plan-to-SQL compiler for @nestm/permissions.",
	"license": "BSD-3-Clause",
	"author": "nestm",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nestm-dev/permissions.git",
		"directory": "packages/permissions-typeorm"
	},
	"homepage": "https://github.com/nestm-dev/permissions/tree/main/packages/permissions-typeorm#readme",
	"bugs": {
		"url": "https://github.com/nestm-dev/permissions/issues"
	},
	"keywords": [
		"nestjs",
		"typeorm",
		"authorization",
		"permissions",
		"cedar",
		"row-level-security",
		"query-builder",
		"esm",
		"nestm"
	],
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.13.0"
	},
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./nestjs": {
			"types": "./dist/nestjs.d.mts",
			"import": "./dist/nestjs.mjs",
			"default": "./dist/nestjs.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs",
			"default": "./dist/testing.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch src",
		"typecheck": "tsc -b",
		"lint": "oxlint --type-aware .",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" package.json",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" package.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify:pack": "pnpm run build && publint --strict",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@nestm/permissions-core": "workspace:^"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0-alpha.5",
		"typeorm": "^1.1.0"
	},
	"peerDependenciesMeta": {
		"@nestjs/common": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nestjs/common": "12.0.0-alpha.5",
		"@types/pg": "8.20.4",
		"fast-check": "^4.9.0",
		"pg": "8.22.0",
		"typeorm": "1.1.0"
	}
}
